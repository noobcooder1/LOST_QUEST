# Optional public API address. Never put passwords, tokens, or private keys in VITE_ variables.
# Copy to .env.local and restart Vite.
# The mobile dev server forwards /api to DEV_API_PROXY_TARGET, so the API address is the dev server itself.
# On a phone in the same Wi-Fi, use this PC's address instead, e.g. http://192.168.0.10:5174
VITE_API_BASE_URL=http://127.0.0.1:5174

# Spring Boot address the dev server forwards /api requests to (not exposed to the browser).
DEV_API_PROXY_TARGET=http://127.0.0.1:8081

# Optional: 'true' shows the reference-only AI photo similarity area on match cards (off by default).
# VITE_FEATURE_AI_PHOTO_SIMILARITY=true
